# ═══════════════════════════════════════════════════════════════
# DCPH-Tracker environment variables — copy to .env.local
#
# 🔐 SECURITY NOTES
# - Never commit .env.local (already gitignored).
# - NEXT_PUBLIC_* vars ship to the BROWSER — never put secrets here.
# - SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server-only, never expose.
# - CRON_SECRET is sent via `Authorization: Bearer` header ONLY —
#   never in a query string (it would leak into logs).
# ═══════════════════════════════════════════════════════════════

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (public, anon role — RLS enforces access)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — SERVER ONLY (admin client, cron sync, user moderation)
SUPABASE_SERVICE_ROLE_KEY=

# Secret for /api/sync cron authorization (sent as Bearer header)
CRON_SECRET=

# Shared secret for the admin task routes, sent as the `x-admin-secret` header. Unset falls back to CRON_SECRET.
ADMIN_TASK_SECRET=

# Minimum level for lib/logger.ts: debug, info, warn or error. Unset means info in prod, debug in dev.
LOG_LEVEL=

# User-Agent lib/dcw.ts sends to the DCW wiki API. Unset means "DCPH-Tracker/1.0 (+https://github.com/your-org/DCPH-Tracker; you@example.com)".
DCW_USER_AGENT=

# Canonical site URL (used for admin-triggered sync requests)
NEXT_PUBLIC_SITE_URL=

# ── AI Chatbot providers (all optional, all free tier) ────────────────
# At least ONE must be set or /api/ai-chat returns 500.
# Every key is server-only: never prefix these with NEXT_PUBLIC_.
#
# Tried in this order, skipping any target whose circuit is open:
#   1. Gemini (AI Studio)   - strict JSON schema support, ~1,400 req/day
#   2. Groq (Cloud)         - fastest, json_object only, ~14,000 req/day
#   3. OpenRouter (:free)   - strict schema unsupported, ~50 req/day per key
#   4. Cerebras             - strict JSON schema support, ~900 req/day
#
# Comma-separate multiple OpenRouter keys in one variable; duplicates and
# blank entries are ignored. OPENROUTER_API_KEY_2 is merged with the first.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
CEREBRAS_API_KEY=

# ── AI memory & transcripts (optional) ────────────────────────────────
# Unset means ON. Set to "off" to disable memory extraction and injection:
# the async writer never runs and the prompt gets no [MEM] section.
# Transcripts still record, and GET/DELETE /api/ai-chat/memory plus the
# conversation endpoints keep working, so a user can still see and remove
# what was stored before the switch was flipped.
AI_MEMORY=

# ── Agentic pipeline (optional) ───────────────────────────────────────
# Which retrieval path /api/ai-chat takes. Unset, or any value other
# than "v1", runs v2 (plan, gather, screen, assemble, cite-validate).
# "v1" restores the previous path — searchAll plus the Plan 3 prompt —
# and is the rollback.
AI_PIPELINE=

# How v2 plans retrieval. Unset means "auto": the deterministic router
# answers first, and one model call is spent only when the router is
# unsure. "always" calls the model every turn; "off" never calls it.
AI_PLANNER=

# ── AI observability (optional) ───────────────────────────────────────
# How long /api/admin/ai-retention keeps rows in ai_request_log, in days.
# Unset means 90. An unparseable, non-integer, zero or negative value
# falls back to 90 — never to 0, which would delete the whole table.
AI_LOG_RETENTION_DAYS=