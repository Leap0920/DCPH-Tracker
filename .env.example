# ═══════════════════════════════════════════════════════════════
# DCPH-Tracker environment variables — copy to .env.local
#
# 🔐 SECURITY NOTES
# - Never commit .env.local (already gitignored).
# - NEXT_PUBLIC_* vars ship to the BROWSER — never put secrets here.
# - SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server-only, never expose.
# - CRON_SECRET is sent via `Authorization: Bearer` header ONLY —
#   never in a query string (it would leak into logs).
# ═══════════════════════════════════════════════════════════════

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (public, anon role — RLS enforces access)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — SERVER ONLY (admin client, cron sync, user moderation)
SUPABASE_SERVICE_ROLE_KEY=

# Secret for /api/sync cron authorization (sent as Bearer header)
CRON_SECRET=

# Gates the /api/admin/* maintenance routes (x-admin-secret header).
# Must be long and random — `openssl rand -base64 32`. A short value is
# guessable, and a committed one is compromised: rotate, don't reuse.
ADMIN_TASK_SECRET=

# Canonical site URL (used for admin-triggered sync requests)
NEXT_PUBLIC_SITE_URL=

# ── AI chat providers (server-only) ──────────────────────────────────────────
# /api/ai-chat needs at least one of these; they are tried in the order
# configured in app/api/ai-chat/route.ts.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# "true" reports CSP violations without blocking them (first-deploy mode).
CSP_REPORT_ONLY=
# debug | info | warn | error
LOG_LEVEL=

# ── Backups (scripts/backup-supabase.sh + .github/workflows/supabase-backup.yml) ──
# Session-pooler URI (IPv4, port 5432) — Dashboard → Connect → Session pooler.
# Contains the database password — never expose it to the browser.
SUPABASE_DB_URL=